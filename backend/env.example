# Backend environment variables
APP_ENV=development
PORT=8080
# Minimum 32 characters in production (required outside development)
JWT_SECRET=your-32-plus-character-secret-key-goes-here-min-32
SQLITE_PATH=appointments.db
TRUST_PROXY=false # Set to true on Render or behind reverse proxies

# Optional initial seed credentials (used only in development or if explicitly set)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=your-secure-admin-password
DEFAULT_PLATFORM_ADMIN_EMAIL=platform@example.com
DEFAULT_PLATFORM_ADMIN_PASSWORD=your-secure-platform-password

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
FRONTEND_URL=http://localhost:3000
