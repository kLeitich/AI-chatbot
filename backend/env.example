# Backend environment variables
# Set to 'development' locally, 'production' on Render / production deployments.
# If unset, APP_ENV fails closed and defaults to 'production'.
APP_ENV=development
PORT=8080

# JWT_SECRET: Minimum 32 characters in production (required outside development).
# Server refuses to start if weak or known default outside development.
JWT_SECRET=your-32-plus-character-secret-key-goes-here-min-32

# SQLite database file path (use /data/appointments.db on persistent disk in Docker/Render)
SQLITE_PATH=appointments.db

# Set to true on Render or behind reverse proxies to enable proper client IP rate limiting
TRUST_PROXY=false

# Optional initial seed credentials (used only in development)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=your-secure-admin-password
DEFAULT_PLATFORM_ADMIN_EMAIL=platform@example.com
DEFAULT_PLATFORM_ADMIN_PASSWORD=your-secure-platform-password

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
FRONTEND_URL=http://localhost:3000
